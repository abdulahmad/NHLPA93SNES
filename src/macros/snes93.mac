; NHLPA Hockey '93 (SNES) macros. Included once by nhlpa93snes.asm, before the bank files (like 93G
; macros/genesis93.mac). Player, String and hex2 build the bank $83 team data (93G teamdata93.asm) with the
; 93G macro names. The String macros write every string the print routines read: a length word that counts
; itself, then the text and control bytes (String: text only; the others name the shape of the bytes).

macro Player(name, w1, w2, w3, w4)	;93G Player: length word (counts itself), name,
	;ratings as 4 big-endian words (hex digits, no $)
?l:	dw ?e-?l
	db "<name>"
?e:	db $<w1>>>8,$<w1>&$FF,$<w2>>>8,$<w2>&$FF,$<w3>>>8,$<w3>&$FF,$<w4>>>8,$<w4>&$FF
endmacro
macro String(text)					;93G String/StringB: length word (counts itself), then the text
?l:	dw ?e-?l
	db "<text>"
?e:
endmacro
macro StringCC(b)					;String of one control byte (no text)
?l:	dw ?e-?l
	db <b>
?e:
endmacro
macro StringCp(cc, x, y)			;control code and position, no text
?l:	dw ?e-?l
	db <cc>,<x>,<y>
?e:
endmacro
macro StringBt(b, text)				;one byte, then the text
?l:	dw ?e-?l
	db <b>,"<text>"
?e:
endmacro
macro StringCt(cc, x, y, text)		;control code, x, y, then the text (a print control code sets the
	;priority, font and map, see CC_Font*)
?l:	dw ?e-?l
	db <cc>,<x>,<y>,"<text>"
?e:
endmacro
macro StringCtc(cc, x, y, text, cc2, x2, y2)	;StringCt, then a second code and position
?l:	dw ?e-?l
	db <cc>,<x>,<y>,"<text>",<cc2>,<x2>,<y2>
?e:
endmacro
macro StringCtctc(cc, x, y, text, cc2, x2, y2, text2, cc3, x3, y3)	;two texts, three codes
?l:	dw ?e-?l
	db <cc>,<x>,<y>,"<text>",<cc2>,<x2>,<y2>,"<text2>",<cc3>,<x3>,<y3>
?e:
endmacro
macro StringTb(text, b)				;the text, then one byte
?l:	dw ?e-?l
	db "<text>",<b>
?e:
endmacro
macro hex2(w1, w2, w3, w4)			;93G hex2: 4 words as big-endian bytes (hex digits, no $)
	db $<w1>>>8,$<w1>&$FF,$<w2>>>8,$<w2>&$FF,$<w3>>>8,$<w3>&$FF,$<w4>>>8,$<w4>&$FF
endmacro
